#!/bin/sh
# Select the loader's ESP before either the mount or its filesystem check runs.
set -eu

efivars=${ARCA_BOOT_EFIVARS:-/sys/firmware/efi/efivars}
variable=$efivars/LoaderDevicePartUUID-4a67b082-0a4c-41cf-b6c7-440b29bb8c4f
what=/dev/disk/by-partlabel/esp

# efivarfs has four attribute bytes, then a NUL-terminated UTF-16LE UUID.
uuid=$(od -An -v -j4 -tu1 "$variable" 2>/dev/null | awk '
{
	for (i = 1; i <= NF; i++) {
		n++
		if (n % 2 == 0 || n == 73) {
			if ($i != 0) bad = 1
		} else {
			value = value sprintf("%c", $i)
		}
	}
}
END {
	if (n != 74 || bad) exit 1
	print tolower(value)
}') || uuid=
if printf '%s\n' "$uuid" | grep -Eq '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'; then
	# The device link may not exist until udev starts; systemd must wait for it.
	what=/dev/disk/by-partuuid/$uuid
fi

# Early output overrides both the vendor mount and the kernel command line.
out=${2:-$1}
mkdir -p "$out"
device=$(systemd-escape --path "$what")
fsck=systemd-fsck@$device.service
cat > "$out/boot.mount" <<EOF
[Unit]
Description=EFI System Partition Automount
Requires=$fsck
After=$fsck
After=blockdev@$device.target

[Mount]
What=$what
Where=/boot
Type=vfat
Options=umask=0077,rw,nodev,nosuid,noexec,nosymfollow
EOF

cat > "$out/$fsck" <<EOF
[Unit]
Description=File System Check on $what
DefaultDependencies=no
BindsTo=$device.device
After=$device.device local-fs-pre.target
Before=shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=-/usr/lib/systemd/systemd-fsck $what
TimeoutSec=infinity
EOF
